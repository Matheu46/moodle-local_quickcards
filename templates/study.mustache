{{!
    @template local_quickcards/study

    QuickCards active recall study session template.
}}
<div class="quickcards-study-session container px-0" style="max-width: 760px;">
    {{#hasdue}}
        <script id="quickcards-session-data" type="application/json">
        {{{cardsjson}}}
        </script>
        <!-- Session Active Container -->
        <div id="study-active-session">
            <!-- Header bar with Navigation & Progress -->
            <div class="card border-0 shadow-sm bg-light mb-4">
                <div class="card-body py-3 px-4">
                    <div class="d-flex justify-content-between align-items-center">
                        <a href="{{backurl}}" class="btn btn-outline-secondary btn-sm" title="{{#str}} backtodecks, local_quickcards {{/str}}">
                            <i class="fa fa-arrow-left me-1" aria-hidden="true"></i>
                            {{#hasdeck}}{{#str}} backtodeck, local_quickcards {{/str}}{{/hasdeck}}
                            {{^hasdeck}}{{#str}} backtodecks, local_quickcards {{/str}}{{/hasdeck}}
                        </a>
                        <span class="fw-bold text-muted" id="study-progress-text">
                            {{#str}} cardof, local_quickcards, {"current": 1, "total": {{totaldue}}} {{/str}}
                        </span>
                    </div>
                    <div class="progress mt-3" style="height: 6px;">
                        <div id="study-progress-bar" class="progress-bar bg-primary" role="progressbar" style="width: 0%;" aria-valuenow="0" aria-valuemin="0" aria-valuemax="100"></div>
                    </div>
                </div>
            </div>

            <!-- Flashcard Container -->
            <div class="card shadow border study-card mb-4" id="study-flashcard">
                <!-- Card Header (Deck info) -->
                <div class="card-header bg-white border-bottom-0 pt-3 pb-0 d-flex justify-content-between align-items-center">
                    <span class="badge text-bg-light border text-muted" id="study-deck-badge">
                        <i class="fa fa-folder-open me-1" aria-hidden="true"></i> <span id="study-deck-name">{{deckname}}</span>
                    </span>
                    <span class="badge text-bg-warning" id="study-streak-badge">
                        <i class="fa fa-refresh me-1" aria-hidden="true"></i> <span id="study-rep-count">0</span>x
                    </span>
                </div>

                <!-- Card Body (Question Front) -->
                <div class="card-body p-4 text-center d-flex flex-column justify-content-center" style="min-height: 280px;">
                    <div class="text-uppercase small fw-bold text-primary mb-2">
                        <i class="fa fa-question-circle me-1" aria-hidden="true"></i> {{#str}} question, local_quickcards {{/str}}
                    </div>
                    <div class="fs-4 my-auto p-2" id="study-question-content"></div>

                    <!-- Flip / Show Answer Action (Visible on front) -->
                    <div class="mt-4 pt-3 border-top" id="study-front-actions">
                        <button type="button" class="btn btn-primary btn-lg px-4" id="study-show-answer-btn">
                            <i class="fa fa-eye me-2" aria-hidden="true"></i> {{#str}} showanswerspace, local_quickcards {{/str}}
                        </button>
                    </div>
                </div>

                <!-- Back Section (Answer + Ratings) - Hidden until flipped -->
                <div class="card-body p-4 pt-0 d-none" id="study-back-section">
                    <div class="p-4 rounded bg-light border-start border-4 border-success text-center mb-4">
                        <div class="text-uppercase small fw-bold text-success mb-2">
                            <i class="fa fa-check-circle me-1" aria-hidden="true"></i> {{#str}} answer, local_quickcards {{/str}}
                        </div>
                        <div class="fs-5" id="study-answer-content"></div>
                    </div>

                    <!-- 4 SM-2 Rating Buttons -->
                    <div class="d-flex flex-column flex-sm-row gap-2" id="study-rating-buttons">
                        <button type="button" class="btn btn-outline-danger flex-grow-1 py-2" data-action="rating" data-rating="1">
                            <div class="fw-bold">[1] {{#str}} rating_again, local_quickcards {{/str}}</div>
                        </button>
                        <button type="button" class="btn btn-outline-warning text-dark flex-grow-1 py-2" data-action="rating" data-rating="2">
                            <div class="fw-bold">[2] {{#str}} rating_hard, local_quickcards {{/str}}</div>
                        </button>
                        <button type="button" class="btn btn-outline-success flex-grow-1 py-2" data-action="rating" data-rating="3">
                            <div class="fw-bold">[3] {{#str}} rating_good, local_quickcards {{/str}}</div>
                        </button>
                        <button type="button" class="btn btn-outline-primary flex-grow-1 py-2" data-action="rating" data-rating="4">
                            <div class="fw-bold">[4] {{#str}} rating_easy, local_quickcards {{/str}}</div>
                        </button>
                    </div>
                </div>
            </div>

            <!-- Keyboard shortcuts guide -->
            <div class="text-center text-muted small">
                {{{keyboard_shortcuts_html}}}
            </div>
        </div>

        <!-- Session Completed Container (Hidden initially) -->
        <div class="card text-center py-5 border-0 shadow-sm d-none" id="study-completed-container">
            <div class="card-body">
                <div class="mb-3 text-success">
                    <i class="fa fa-trophy fa-4x" aria-hidden="true"></i>
                </div>
                <h3 class="h3 card-title text-success mb-2">{{#str}} sessioncomplete, local_quickcards {{/str}}</h3>
                <p class="card-text text-muted mx-auto mb-4" style="max-width: 480px;">
                    {{#str}} sessioncompletedesc, local_quickcards {{/str}}
                </p>
                <div class="d-flex justify-content-center gap-2">
                    <a href="{{backurl}}" class="btn btn-primary px-4">
                        <i class="fa fa-check me-1" aria-hidden="true"></i> {{#str}} backtodecks, local_quickcards {{/str}}
                    </a>
                </div>
            </div>
        </div>
    {{/hasdue}}

    {{^hasdue}}
        <!-- Empty / Caught up State -->
        <div class="card text-center py-5 border-0 shadow-sm">
            <div class="card-body">
                <div class="mb-3 text-success">
                    <i class="fa fa-check-circle fa-4x" aria-hidden="true"></i>
                </div>
                <h3 class="h4 card-title">{{#str}} congratulations, local_quickcards {{/str}}</h3>
                <p class="card-text text-muted mx-auto mb-4" style="max-width: 450px;">
                    {{#str}} noduecards, local_quickcards {{/str}}
                </p>
                <a href="{{backurl}}" class="btn btn-outline-primary px-4">
                    <i class="fa fa-arrow-left me-1" aria-hidden="true"></i> {{#str}} backtodecks, local_quickcards {{/str}}
                </a>
            </div>
        </div>
    {{/hasdue}}
</div>
