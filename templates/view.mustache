{{!
    @template local_quickcards/view

    QuickCards main student dashboard template.
}}
<div class="quickcards-dashboard container-fluid px-0">
    <!-- Top Action Bar & Summary Stats -->
    <div class="row align-items-center mb-4 g-3">
        <div class="col-md-6">
            <p class="text-muted mb-0">{{#str}} nodecksdesc, local_quickcards {{/str}}</p>
        </div>
        <div class="col-md-6 text-md-end">
            {{#hasdue}}
                <a href="{{studyallurl}}" class="btn btn-success me-2">
                    <i class="fa fa-play me-1" aria-hidden="true"></i> {{#str}} studyall, local_quickcards {{/str}} ({{totaldue}})
                </a>
            {{/hasdue}}
            <button type="button" class="btn btn-primary" data-action="quickcards-create-deck" data-bs-toggle="modal" data-bs-target="#quickcards-deck-modal">
                <i class="fa fa-plus me-1" aria-hidden="true"></i> {{#str}} createdeck, local_quickcards {{/str}}
            </button>
        </div>
    </div>

    <!-- Quick Stats Cards -->
    <div class="row g-3 mb-4">
        <div class="col-sm-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm bg-light">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle p-3 bg-primary text-white me-3">
                        <i class="fa fa-folder-open fa-2x" aria-hidden="true"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-bold">{{#str}} totaldecks, local_quickcards {{/str}}</div>
                        <div class="fs-4 fw-bold">{{totaldecks}}</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-6 col-lg-4">
            <div class="card h-100 border-0 shadow-sm bg-light">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle p-3 bg-info text-white me-3">
                        <i class="fa fa-clone fa-2x" aria-hidden="true"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-bold">{{#str}} totalcards, local_quickcards {{/str}}</div>
                        <div class="fs-4 fw-bold">{{totalcards}}</div>
                    </div>
                </div>
            </div>
        </div>
        <div class="col-sm-12 col-lg-4">
            <div class="card h-100 border-0 shadow-sm {{#hasdue}}bg-warning-subtle border-warning{{/hasdue}}{{^hasdue}}bg-light{{/hasdue}}">
                <div class="card-body d-flex align-items-center">
                    <div class="rounded-circle p-3 {{#hasdue}}bg-warning text-dark{{/hasdue}}{{^hasdue}}bg-secondary text-white{{/hasdue}} me-3">
                        <i class="fa fa-clock-o fa-2x" aria-hidden="true"></i>
                    </div>
                    <div>
                        <div class="text-muted small text-uppercase fw-bold">{{#str}} dueforreview, local_quickcards {{/str}}</div>
                        <div class="fs-4 fw-bold">{{totaldue}}</div>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <!-- Decks List Section -->
    {{#hasdecks}}
        <div class="row row-cols-1 row-cols-md-2 row-cols-lg-3 g-4" id="quickcards-decks-container">
            {{#decks}}
                <div class="col" id="deck-card-{{id}}">
                    <div class="card h-100 shadow-sm border">
                        <div class="card-body d-flex flex-column">
                            <div class="d-flex justify-content-between align-items-start mb-2">
                                <h3 class="card-title h5 mb-0 text-truncate" title="{{name}}">
                                    <a href="{{deckurl}}" class="text-decoration-none text-dark">{{name}}</a>
                                </h3>
                                <div class="dropdown">
                                    <button class="btn btn-sm btn-icon text-muted" type="button" data-bs-toggle="dropdown" aria-expanded="false" title="{{#str}} actions, local_quickcards {{/str}}">
                                        <i class="fa fa-ellipsis-v" aria-hidden="true"></i>
                                    </button>
                                    <ul class="dropdown-menu dropdown-menu-end shadow-sm">
                                        <li>
                                            <a class="dropdown-item" href="#" data-action="quickcards-edit-deck" data-bs-toggle="modal" data-bs-target="#quickcards-deck-modal" data-id="{{id}}" data-name="{{rawname}}" data-description="{{rawdescription}}" data-courseid="{{courseid}}">
                                                <i class="fa fa-pencil me-2 text-primary" aria-hidden="true"></i> {{#str}} editdeck, local_quickcards {{/str}}
                                            </a>
                                        </li>
                                        <li>
                                            <a class="dropdown-item" href="#" data-action="quickcards-reset-deck" data-id="{{id}}" data-name="{{rawname}}">
                                                <i class="fa fa-refresh me-2 text-warning" aria-hidden="true"></i> {{#str}} resetprogress, local_quickcards {{/str}}
                                            </a>
                                        </li>
                                        <li><hr class="dropdown-divider"></li>
                                        <li>
                                            <a class="dropdown-item text-danger" href="#" data-action="quickcards-delete-deck" data-id="{{id}}" data-name="{{rawname}}">
                                                <i class="fa fa-trash me-2" aria-hidden="true"></i> {{#str}} deletedeck, local_quickcards {{/str}}
                                            </a>
                                        </li>
                                    </ul>
                                </div>
                            </div>

                            {{#hascourse}}
                                <div class="mb-2">
                                    <span class="badge text-bg-light border text-truncate d-inline-block" style="max-width: 100%;">
                                        <i class="fa fa-graduation-cap me-1" aria-hidden="true"></i> {{coursename}}
                                    </span>
                                </div>
                            {{/hascourse}}

                            {{#description}}
                                <div class="card-text text-muted small mb-3 flex-grow-1" style="max-height: 4.5em; overflow: hidden; text-overflow: ellipsis;">
                                    {{{description}}}
                                </div>
                            {{/description}}
                            {{^description}}
                                <div class="flex-grow-1"></div>
                            {{/description}}

                            <div class="d-flex justify-content-between align-items-center pt-3 border-top mt-auto">
                                <span class="text-muted small">
                                    <i class="fa fa-clone me-1" aria-hidden="true"></i> {{totalcards}} {{#str}} cards, local_quickcards {{/str}}
                                </span>
                                <div>
                                    {{#hasdue}}
                                        <span class="badge text-bg-warning me-2">{{duecount}} {{#str}} dueforreview, local_quickcards {{/str}}</span>
                                    {{/hasdue}}
                                    {{^hasdue}}
                                        {{#hascards}}
                                            <span class="badge text-bg-success me-2"><i class="fa fa-check me-1" aria-hidden="true"></i> 0 due</span>
                                        {{/hascards}}
                                    {{/hasdue}}
                                </div>
                            </div>
                        </div>
                        <div class="card-footer bg-transparent border-top-0 d-flex gap-2 pb-3">
                            <a href="{{deckurl}}" class="btn btn-outline-secondary btn-sm flex-grow-1">
                                <i class="fa fa-list me-1" aria-hidden="true"></i> {{#str}} managecards, local_quickcards {{/str}}
                            </a>
                            {{#hascards}}
                                <a href="{{studyurl}}" class="btn {{#hasdue}}btn-primary{{/hasdue}}{{^hasdue}}btn-outline-primary{{/hasdue}} btn-sm flex-grow-1">
                                    <i class="fa fa-play me-1" aria-hidden="true"></i> {{#str}} studydeck, local_quickcards {{/str}}
                                </a>
                            {{/hascards}}
                        </div>
                    </div>
                </div>
            {{/decks}}
        </div>
    {{/hasdecks}}

    {{^hasdecks}}
        <div class="card text-center py-5 border-dashed shadow-sm">
            <div class="card-body">
                <div class="mb-3 text-primary opacity-75">
                    <i class="fa fa-clone fa-4x" aria-hidden="true"></i>
                </div>
                <h3 class="h4 card-title">{{#str}} nodecks, local_quickcards {{/str}}</h3>
                <p class="card-text text-muted mx-auto" style="max-width: 500px;">
                    {{#str}} nodecksdesc, local_quickcards {{/str}}
                </p>
                <button type="button" class="btn btn-primary mt-2" data-action="quickcards-create-deck" data-bs-toggle="modal" data-bs-target="#quickcards-deck-modal">
                    <i class="fa fa-plus me-1" aria-hidden="true"></i> {{#str}} createdeck, local_quickcards {{/str}}
                </button>
            </div>
        </div>
    {{/hasdecks}}
</div>

<!-- Modal: Create / Edit Deck -->
<div class="modal fade" id="quickcards-deck-modal" tabindex="-1" aria-labelledby="quickcards-deck-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="quickcards-deck-form">
                <div class="modal-header">
                    <h5 class="modal-title" id="quickcards-deck-modal-title">{{#str}} createdeck, local_quickcards {{/str}}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{#str}} close, local_quickcards {{/str}}"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="quickcards-deck-id" value="0">
                    
                    <div class="mb-3">
                        <label for="quickcards-deck-name" class="form-label fw-bold">{{#str}} deckname, local_quickcards {{/str}} <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="quickcards-deck-name" required placeholder="e.g. Psychology 101 - Cognitive Bias">
                    </div>

                    <div class="mb-3">
                        <label for="quickcards-deck-description" class="form-label fw-bold">{{#str}} deckdescription, local_quickcards {{/str}}</label>
                        <textarea class="form-control" id="quickcards-deck-description" rows="3" placeholder="Optional notes about what this deck covers..."></textarea>
                    </div>

                    <div class="mb-3">
                        <label for="quickcards-deck-course" class="form-label fw-bold">{{#str}} coursedeck, local_quickcards {{/str}}</label>
                        <select class="form-select" id="quickcards-deck-course">
                            <option value="0">{{#str}} generaldeck, local_quickcards {{/str}}</option>
                            {{#courses}}
                                <option value="{{id}}">{{fullname}}</option>
                            {{/courses}}
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{#str}} cancel, local_quickcards {{/str}}</button>
                    <button type="submit" class="btn btn-primary" id="quickcards-deck-submit-btn">
                        <i class="fa fa-save me-1" aria-hidden="true"></i> {{#str}} save, local_quickcards {{/str}}
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
