{{!
    @template local_quickcards/deck

    QuickCards individual deck card management template.
}}
<div class="quickcards-deck-view container-fluid px-0">
    <!-- Deck Header Banner -->
    <div class="card border-0 shadow-sm bg-light mb-4">
        <div class="card-body p-4">
            <div class="d-flex flex-column flex-md-row justify-content-between align-items-md-center gap-3">
                <div>
                    <div class="d-flex align-items-center gap-2 mb-2">
                        <a href="{{config.wwwroot}}/local/quickcards/view.php" class="btn btn-outline-secondary btn-sm" title="{{#str}} backtodecks, local_quickcards {{/str}}">
                            <i class="fa fa-arrow-left" aria-hidden="true"></i>
                        </a>
                        <h2 class="h3 mb-0">{{deck.name}}</h2>
                        {{#deck.hascourse}}
                            <span class="badge text-bg-light border">
                                <i class="fa fa-graduation-cap me-1" aria-hidden="true"></i> {{deck.coursename}}
                            </span>
                        {{/deck.hascourse}}
                    </div>
                    {{#deck.description}}
                        <div class="text-muted small mt-2">
                            {{{deck.description}}}
                        </div>
                    {{/deck.description}}
                </div>
                <div class="d-flex gap-2 align-items-center">
                    {{#deck.hascards}}
                        <a href="{{deck.studyurl}}" class="btn {{#deck.hasdue}}btn-success{{/deck.hasdue}}{{^deck.hasdue}}btn-outline-primary{{/deck.hasdue}}">
                            <i class="fa fa-play me-1" aria-hidden="true"></i> {{#str}} studydeck, local_quickcards {{/str}}
                            {{#deck.hasdue}}({{deck.duecount}}){{/deck.hasdue}}
                        </a>
                    {{/deck.hascards}}
                    <button type="button" class="btn btn-primary" data-action="quickcards-create-card" data-bs-toggle="modal" data-bs-target="#quickcards-card-modal" data-deckid="{{deck.id}}">
                        <i class="fa fa-plus me-1" aria-hidden="true"></i> {{#str}} addcard, local_quickcards {{/str}}
                    </button>
                    <button type="button" class="btn btn-outline-secondary" data-action="quickcards-edit-deck" data-bs-toggle="modal" data-bs-target="#quickcards-deck-modal" data-id="{{deck.id}}" data-name="{{deck.rawname}}" data-description="{{deck.rawdescription}}" data-courseid="{{deck.courseid}}" title="{{#str}} editdeck, local_quickcards {{/str}}">
                        <i class="fa fa-pencil" aria-hidden="true"></i>
                    </button>
                </div>
            </div>
        </div>
    </div>

    <!-- Cards List Section -->
    <div class="d-flex justify-content-between align-items-center mb-3">
        <h4 class="h5 mb-0 text-muted">
            <i class="fa fa-clone me-2" aria-hidden="true"></i>{{#str}} cards, local_quickcards {{/str}} ({{deck.totalcards}})
        </h4>
        {{#deck.hasdue}}
            <span class="badge text-bg-warning fs-6">
                <i class="fa fa-clock-o me-1" aria-hidden="true"></i> {{deck.duecount}} {{#str}} dueforreview, local_quickcards {{/str}}
            </span>
        {{/deck.hasdue}}
    </div>

    {{#deck.hascards}}
        <div class="row row-cols-1 row-cols-md-2 g-3" id="quickcards-cards-container">
            {{#deck.cards}}
                <div class="col" id="card-item-{{id}}">
                    <div class="card h-100 shadow-sm border {{#isdue}}border-warning{{/isdue}}">
                        <div class="card-header bg-white d-flex justify-content-between align-items-center py-2">
                            <div>
                                {{#isdue}}
                                    <span class="badge text-bg-warning">
                                        <i class="fa fa-clock-o me-1" aria-hidden="true"></i> {{#str}} today, local_quickcards {{/str}}
                                    </span>
                                {{/isdue}}
                                {{^isdue}}
                                    <span class="badge text-bg-light border text-muted">
                                        <i class="fa fa-calendar me-1" aria-hidden="true"></i> {{nextreviewhuman}}
                                    </span>
                                {{/isdue}}
                                <span class="badge text-bg-light border text-muted ms-1" title="Repetitions">
                                    {{repetitions}}x
                                </span>
                            </div>
                            <div class="btn-group btn-group-sm">
                                <button type="button" class="btn btn-outline-secondary" data-action="quickcards-edit-card" data-bs-toggle="modal" data-bs-target="#quickcards-card-modal" data-id="{{id}}" data-question="{{rawquestion}}" data-answer="{{rawanswer}}" title="{{#str}} editcard, local_quickcards {{/str}}">
                                    <i class="fa fa-pencil text-primary" aria-hidden="true"></i>
                                </button>
                                <button type="button" class="btn btn-outline-secondary" data-action="quickcards-delete-card" data-id="{{id}}" title="{{#str}} deletecard, local_quickcards {{/str}}">
                                    <i class="fa fa-trash text-danger" aria-hidden="true"></i>
                                </button>
                            </div>
                        </div>
                        <div class="card-body">
                            <!-- Question Front -->
                            <div class="mb-3">
                                <div class="text-uppercase small fw-bold text-muted mb-1">
                                    <i class="fa fa-question-circle me-1 text-primary" aria-hidden="true"></i> {{#str}} question, local_quickcards {{/str}}
                                </div>
                                <div class="p-2 rounded bg-light border-start border-4 border-primary">
                                    {{{question}}}
                                </div>
                            </div>
                            <!-- Answer Back -->
                            <div>
                                <div class="text-uppercase small fw-bold text-muted mb-1">
                                    <i class="fa fa-check-circle me-1 text-success" aria-hidden="true"></i> {{#str}} answer, local_quickcards {{/str}}
                                </div>
                                <div class="p-2 rounded bg-light border-start border-4 border-success">
                                    {{{answer}}}
                                </div>
                            </div>
                        </div>
                    </div>
                </div>
            {{/deck.cards}}
        </div>
    {{/deck.hascards}}

    {{^deck.hascards}}
        <div class="card text-center py-5 border-dashed shadow-sm">
            <div class="card-body">
                <div class="mb-3 text-secondary opacity-75">
                    <i class="fa fa-file-text-o fa-4x" aria-hidden="true"></i>
                </div>
                <h4 class="card-title">{{#str}} nocards, local_quickcards {{/str}}</h4>
                <p class="card-text text-muted mx-auto" style="max-width: 500px;">
                    {{#str}} nocardsdesc, local_quickcards {{/str}}
                </p>
                <button type="button" class="btn btn-primary mt-2" data-action="quickcards-create-card" data-bs-toggle="modal" data-bs-target="#quickcards-card-modal" data-deckid="{{deck.id}}">
                    <i class="fa fa-plus me-1" aria-hidden="true"></i> {{#str}} addcard, local_quickcards {{/str}}
                </button>
            </div>
        </div>
    {{/deck.hascards}}
</div>

<!-- Modal: Create / Edit Card -->
<div class="modal fade" id="quickcards-card-modal" tabindex="-1" aria-labelledby="quickcards-card-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered modal-lg">
        <div class="modal-content">
            <form id="quickcards-card-form">
                <div class="modal-header">
                    <h5 class="modal-title" id="quickcards-card-modal-title">{{#str}} addcard, local_quickcards {{/str}}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{#str}} close, local_quickcards {{/str}}"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="quickcards-card-id" value="0">
                    <input type="hidden" id="quickcards-card-deckid" value="{{deck.id}}">

                    <div class="mb-3">
                        <label for="quickcards-card-question" class="form-label fw-bold">
                            <i class="fa fa-question-circle text-primary me-1" aria-hidden="true"></i> {{#str}} question, local_quickcards {{/str}} <span class="text-danger">*</span>
                        </label>
                        <textarea class="form-control" id="quickcards-card-question" rows="4" required placeholder="What concept, prompt or question do you want to recall?"></textarea>
                        <div class="form-text text-muted">{{#str}} question_help, local_quickcards {{/str}}</div>
                    </div>

                    <div class="mb-3">
                        <label for="quickcards-card-answer" class="form-label fw-bold">
                            <i class="fa fa-check-circle text-success me-1" aria-hidden="true"></i> {{#str}} answer, local_quickcards {{/str}} <span class="text-danger">*</span>
                        </label>
                        <textarea class="form-control" id="quickcards-card-answer" rows="4" required placeholder="What is the answer, formula, or key definition?"></textarea>
                        <div class="form-text text-muted">{{#str}} answer_help, local_quickcards {{/str}}</div>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{#str}} cancel, local_quickcards {{/str}}</button>
                    <button type="submit" class="btn btn-primary" id="quickcards-card-submit-btn">
                        <i class="fa fa-save me-1" aria-hidden="true"></i> {{#str}} save, local_quickcards {{/str}}
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>

<!-- Modal: Edit Deck (available inside deck.php as well) -->
<div class="modal fade" id="quickcards-deck-modal" tabindex="-1" aria-labelledby="quickcards-deck-modal-title" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content">
            <form id="quickcards-deck-form">
                <div class="modal-header">
                    <h5 class="modal-title" id="quickcards-deck-modal-title">{{#str}} editdeck, local_quickcards {{/str}}</h5>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="{{#str}} close, local_quickcards {{/str}}"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" id="quickcards-deck-id" value="{{deck.id}}">
                    
                    <div class="mb-3">
                        <label for="quickcards-deck-name" class="form-label fw-bold">{{#str}} deckname, local_quickcards {{/str}} <span class="text-danger">*</span></label>
                        <input type="text" class="form-control" id="quickcards-deck-name" value="{{deck.rawname}}" required>
                    </div>

                    <div class="mb-3">
                        <label for="quickcards-deck-description" class="form-label fw-bold">{{#str}} deckdescription, local_quickcards {{/str}}</label>
                        <textarea class="form-control" id="quickcards-deck-description" rows="3">{{deck.rawdescription}}</textarea>
                    </div>

                    <div class="mb-3">
                        <label for="quickcards-deck-course" class="form-label fw-bold">{{#str}} coursedeck, local_quickcards {{/str}}</label>
                        <select class="form-select" id="quickcards-deck-course">
                            <option value="0">{{#str}} generaldeck, local_quickcards {{/str}}</option>
                            {{#courses}}
                                <option value="{{id}}">{{fullname}}</option>
                            {{/courses}}
                        </select>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-secondary" data-bs-dismiss="modal">{{#str}} cancel, local_quickcards {{/str}}</button>
                    <button type="submit" class="btn btn-primary" id="quickcards-deck-submit-btn">
                        <i class="fa fa-save me-1" aria-hidden="true"></i> {{#str}} save, local_quickcards {{/str}}
                    </button>
                </div>
            </form>
        </div>
    </div>
</div>
